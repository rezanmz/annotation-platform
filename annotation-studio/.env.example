# Local Vinext/Workers development uses .dev.vars, not this file.
# Local email/password authentication is the default. Roles come from accounts in the database.
AUTH_MODE=local

# Only used when explicitly selecting AUTH_MODE=chatgpt in a hosted environment.
# These variables do not promote local password accounts to administrators.
ADMIN_EMAILS=your-admin@example.com
ADMIN_USER_IDS=
